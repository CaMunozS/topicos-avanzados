    "plt.title('Matriz de Confusión en el Conjunto de Prueba')\n",
    "plt.show()\n",
    "\n",
    "# Generate Classification Report\n",
    "report = classification_report(y_test_true, y_pred_test, target_names=['Normal', 'Fraude'])\n",
